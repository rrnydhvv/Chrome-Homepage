{
  "manifest_version": 3,
  "name": "Chrome Homepage",
  "version": "1.1",
  "default_locale": "vi",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ]
}